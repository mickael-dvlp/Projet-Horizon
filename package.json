{
  "name": "projet-memo-app",
  "version": "0.1.2",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "electron": "electron .",
    "electron:build": "next build && electron-builder --win --publish never",
    "electron:release": "next build && dotenv -e .env.local -- electron-builder --win --publish always"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dompurify": "^3.4.14",
    "electron-updater": "^6.8.9",
    "firebase": "^12.14.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "next": "^16.3.2",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "^16.3.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.horizon.app",
    "productName": "Horizon",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "out"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "mickael-dvlp",
      "repo": "Projet-Horizon",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/images/favicon/icon_app_square.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
