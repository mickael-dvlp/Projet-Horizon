rules_version = '2';

// Règles de référence pour ce projet — à déployer avec
// `npx firebase-tools deploy --only firestore:rules` (voir README).
//
// Modèle de données : un document par utilisateur, users/{uid}, contenant la
// structure de ses univers/livres/chapitres, et un document par texte
// (chapitre, scène, fiche) dans users/{uid}/contents/{id}. Seul le
// propriétaire du compte peut lire ou écrire ses propres documents.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /contents/{contentId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
