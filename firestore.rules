rules_version = '2';

// Règles de référence pour ce projet — à déployer via la console Firebase
// (Firestore Database > Règles) ou `firebase deploy --only firestore:rules`
// si le projet est initialisé avec la Firebase CLI (firebase init).
//
// Modèle de données actuel : un seul document par utilisateur, à l'emplacement
// users/{uid}, contenant l'intégralité de ses projets/pages/base de connaissances.
// Seul le propriétaire du compte doit pouvoir lire ou écrire son propre document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
